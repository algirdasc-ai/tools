APP_TITLE=YourAppTitle

# Optional. If set, used for OG tags and share links.
# Example: https://tools.example.com
APP_BASE_URL=

# Optional. Code beautify service used by the auto-format feature.
# Defaults to {APP_BASE_URL}/tools/beautify
BEAUTIFY_URL=

MYSQL_HOST=mysql
MYSQL_USER=tools
# CHANGE THIS to a strong random password before deploying.
MYSQL_PASSWORD=tools
MYSQL_DATABASE=tools
